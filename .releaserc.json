{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run release:android -- ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "apps/client/android/app/build/outputs/apk/debug/app-debug.apk",
            "name": "KnowsPreparation-${nextRelease.gitTag}.apk",
            "label": "Android APK (${nextRelease.gitTag})"
          }
        ],
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
